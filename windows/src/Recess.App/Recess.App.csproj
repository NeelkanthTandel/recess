<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- x64 only for now; it also runs on Windows on Arm under emulation. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Recess</AssemblyName>
    <RootNamespace>Recess.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Recess.ico</ApplicationIcon>
    <!-- Recess's own text is English, so WPF's translated resources aren't shipped. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recess.Core\Recess.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Recess.ico;Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The HTML themes are shared with the Mac app and ship as loose folders. -->
    <Content Include="..\..\..\Resources\Themes\**\*" LinkBase="Themes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
