<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime is on (see scripts/build_app.sh). This is the only resource it needs:
	     calendar access, for calendar-timed breaks and calendar rules. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
